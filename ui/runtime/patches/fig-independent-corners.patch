+#[test]
+fn imports_independent_corners_when_flag_is_absent() {
+    let mut sc = SCHEMA.to_string();
+    sc = sc.replace("float cornerRadius,", "float cornerRadius, bool rectangleCornerRadiiIndependent, float rectangleTopLeftCornerRadius, float rectangleTopRightCornerRadius, float rectangleBottomRightCornerRadius, float rectangleBottomLeftCornerRadius,");
+    let sc = Schema::parse(&sc).unwrap();
+    for flag in [None, Some(true), Some(false)] {
+        let mut props = vec![("size", xy(100.0, 100.0)), ("cornerRadius", f(12.0)),
+            ("rectangleTopLeftCornerRadius", f(4.0)), ("rectangleTopRightCornerRadius", f(8.0)),
+            ("rectangleBottomRightCornerRadius", f(12.0)), ("rectangleBottomLeftCornerRadius", f(16.0))];
+        if let Some(value) = flag { props.push(("rectangleCornerRadiiIndependent", Kv::Bool(value))); }
+        let msg = o(vec![("nodeChanges", arr(vec![node(1, None, "CANVAS", "Page", vec![]),
+            node(2, Some((1, "!")), "RECTANGLE", "Mixed", props)]))]);
+        let bytes = zip_file(&canvas(&sc, &msg));
+        let (doc, _) = import(&bytes, "corners").unwrap();
+        let want = if flag == Some(false) { [12.0; 4] } else { [4.0, 8.0, 12.0, 16.0] };
+        assert_eq!(named(&doc, "Mixed").corners.radii, want);
+    }
